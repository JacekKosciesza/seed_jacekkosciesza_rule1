//@version=6
indicator("Rule #1 Sticker Price Bands (codegen)", overlay = true)

// Auto-generated by invest/scripts/build-pine-codegen.mjs — do not edit by hand.
// Rebuild + repaste when the invest numbers change or you add tickers.
// Covered: ACN, EPAM, GOOGL, LULU. Renders only on these symbols.

transp = input.int(82, "Band transparency", minval = 0, maxval = 100)

// ── Per-ticker annual buy-price anchors (fractional year, buy price) ──
var float[] acn_y = array.from(2014.666, 2015.666, 2016.666, 2017.666, 2018.666, 2019.666, 2020.666, 2021.666, 2022.666, 2023.666, 2024.666, 2025.666, 2026.583)
var float[] acn_b = array.from(94.07, 99.07, 134.24, 113.22, 131.95, 153.18, 164.21, 190.64, 222.90, 224.15, 238.09, 252.87, 252.87)
var float[] epam_y = array.from(2014.999, 2015.999, 2016.999, 2017.999, 2018.999, 2019.999, 2020.999, 2021.999, 2022.999, 2023.999, 2024.999, 2025.999, 2026.583)
var float[] epam_b = array.from(30.66, 35.48, 40.96, 28.91, 92.86, 99.22, 122.65, 178.50, 155.28, 154.63, 171.71, 147.18, 147.18)
var float[] googl_y = array.from(2014.999, 2015.999, 2016.999, 2017.999, 2018.999, 2019.999, 2020.999, 2021.999, 2022.999, 2023.999, 2024.999, 2025.999, 2026.583)
var float[] googl_b = array.from(38.18, 42.32, 51.69, 33.41, 81.11, 91.24, 108.77, 208.25, 169.27, 215.30, 298.45, 401.28, 401.28)
var float[] lulu_y = array.from(2014.082, 2014.086, 2015.082, 2015.083, 2016.082, 2017.077, 2017.082, 2018.074, 2018.082, 2019.082, 2019.089, 2020.082, 2020.086, 2021.082, 2022.079, 2022.082, 2023.077, 2023.082, 2024.074, 2024.082, 2025.082, 2025.086, 2026.082, 2026.083, 2026.583)
var float[] lulu_b = array.from(54.46, 54.46, 47.33, 47.33, 53.88, 63.01, 63.01, 54.17, 54.17, 102.92, 102.92, 140.56, 140.56, 128.30, 213.54, 213.54, 190.45, 190.45, 347.83, 347.83, 417.39, 417.39, 378.05, 378.05, 378.05)

// Linear interpolation of value v(x) over parallel arrays xs/vs (clamped)
f_interp(float[] xs, float[] vs, float x) =>
    int n = array.size(xs)
    float out = na
    if x <= array.get(xs, 0)
        out := array.get(vs, 0)
    else if x >= array.get(xs, n - 1)
        out := array.get(vs, n - 1)
    else
        for i = 0 to n - 2
            float x0 = array.get(xs, i)
            float x1 = array.get(xs, i + 1)
            if x >= x0 and x <= x1
                float v0 = array.get(vs, i)
                float v1 = array.get(vs, i + 1)
                out := v0 + (v1 - v0) * (x - x0) / (x1 - x0)
                break
    out

fy = year(time) + (month(time) - 1) / 12.0 + (dayofmonth(time) - 1) / 365.0

f_buy(float fy) =>
    float b = na
    if syminfo.ticker == "ACN"
        b := f_interp(acn_y, acn_b, fy)
    else if syminfo.ticker == "EPAM"
        b := f_interp(epam_y, epam_b, fy)
    else if syminfo.ticker == "GOOGL"
        b := f_interp(googl_y, googl_b, fy)
    else if syminfo.ticker == "LULU"
        b := f_interp(lulu_y, lulu_b, fy)
    b

buyPrice  = f_buy(fy)
sticker   = buyPrice * 2.0        // 50% MOS: sticker = 2 × buy
buy20     = buyPrice * 1.20
sticker20 = sticker  * 1.20

// ── Colors (matched to the ruleonetoolbox chart) ──
cBuy       = color.rgb(46, 139, 76)    // Buy Price          — dark green
cBuy20     = color.rgb(200, 227, 194)  // 20% Above Buy      — light green
cSticker   = color.rgb(197, 232, 247)  // Sticker Price      — light blue
cSticker20 = color.rgb(165, 28, 28)    // 20% Above Sticker  — dark red

// ── Invisible band edges (fill boundaries only) ──
pZero      = plot(na(buyPrice) ? na : 0, "Zero base",         display = display.none)
pBuy       = plot(buyPrice,               "Buy Price",         display = display.none)
pBuy20     = plot(buy20,                   "20% Above Buy",     display = display.none)
pSticker   = plot(sticker,                 "Sticker Price",     display = display.none)
pSticker20 = plot(sticker20,               "20% Above Sticker", display = display.none)

// ── Semi-transparent filled bands, bottom → top ──
fill(pZero,    pBuy,       color = color.new(cBuy,       transp), title = "Buy Price")
fill(pBuy,     pBuy20,     color = color.new(cBuy20,     transp), title = "20% Above Buy Price")
fill(pBuy20,   pSticker,   color = color.new(cSticker,   transp), title = "Sticker Price")
fill(pSticker, pSticker20, color = color.new(cSticker20, transp), title = "20% Above Sticker")
